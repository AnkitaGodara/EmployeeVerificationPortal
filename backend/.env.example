# Copy to .env and fill in. Never commit .env.

# --- Login security (change both before sharing the app) ---
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USER_ID=admin
ADMIN_PASSWORD=Admin@123

# --- LLM for the RAG assistant: groq | gemini | openai | none ---
LLM_PROVIDER=groq
GROQ_API_KEY=            # free key: https://console.groq.com/keys
GROQ_MODEL=llama-3.1-8b-instant
GOOGLE_API_KEY=          # for LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=          # for LLM_PROVIDER=openai

# --- Retrieval ---
EMBEDDINGS_PROVIDER=tfidf   # tfidf (no download) | fastembed | huggingface
RETRIEVAL_MODE=hybrid       # hybrid | vector | bm25
TOP_K=4

# --- Face model ---
CONFIDENCE_THRESHOLD=0.70
EPOCHS=40
MIN_IMAGES_PER_PERSON=5

# --- Hosted demo (optional) ---
# A visitor login with the 'security' role (can verify and use the assistant, nothing else).
DEMO_USER_ID=
DEMO_PASSWORD=
# Zip with one folder of photos per person. On a fresh start with no trained model, the app
# downloads it, enrols everyone, applies SEED_DETAILS and trains automatically.
# Use a PRIVATE Hugging Face dataset and a read-only token so the photos are never public.
SEED_ZIP_URL=
SEED_ZIP_TOKEN=
# SEED_DETAILS=scripts/employees.sample.json

# --- Deployment ---
CORS_ORIGINS=http://localhost:5173
# DATA_DIR=/data
